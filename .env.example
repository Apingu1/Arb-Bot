# Phase 1.7 is observer/shadow only. No wallet, private key, signing or live order placement is used.
MARKET_QUERY=Up or Down 15m
MARKET_ASSETS=BTC,ETH,HYPE,BNB,DOGE,XRP,SOL
# Only LIVE/NEXT are streamed; direct discovery looks slightly ahead to survive Gamma lag.
MARKET_LOOKAHEAD_INTERVALS=2

# Fast small-size taker benchmark.
MIN_NET_EDGE_PER_SHARE=0.001
MIN_EXPECTED_PROFIT_USDC=0.001
MIN_TRADE_SHARES=1
MAX_TRADE_SHARES=5
RISK_BUFFER_PER_SHARE=0.002
RECOVERY_PENALTY_PER_SHARE=0.002
SHADOW_LATENCY_MS=5
SHADOW_RECOVERY_LATENCY_MS=10
MARKET_COOLDOWN_MS=100
MAX_BOOK_AGE_MS=250
# The old 10ms timer could not cleanly service 1-2ms shadow variants.
STRATEGY_TIMER_INTERVAL_MS=1

# Phase 1.3 queue-aware MAKER/HYBRID controls remain active for comparison.
MAKER_SHADOW_ENABLED=true
MAKER_TRADE_SHARES=5
MAKER_VARIANT_TARGETS=0.99,0.98,0.97,0.96
MAKER_TICK_SIZE=0.01
MAKER_MIN_GROSS_EDGE_PER_SHARE=0.005
MAKER_ORDER_TTL_MS=1500
MAKER_MAX_QUOTE_AGE_MS=30000
MAKER_REPRICE_TICKS=2
MAKER_REQUOTE_COOLDOWN_MS=500
MAKER_INVENTORY_TIMEOUT_MS=5000
MAKER_MIN_SECONDS_TO_EXPIRY=30
MAKER_USE_EMPIRICAL_RISK_GATE=false
MAKER_EMPIRICAL_RISK_MIN_SAMPLES=20

# Phase 1.7 selective paired-maker controls. PMAKER joins the current best bids
# only when their combined cost is already <= target and both displayed queues
# are below the variant cap. It does not step deeper to manufacture an edge.
PAIRED_MAKER_ENABLED=true
PAIRED_MAKER_TRADE_SHARES=1
PAIRED_MAKER_TARGET_PAIR=0.99
PAIRED_MAKER_MIN_GROSS_EDGE_PER_SHARE=0.005
PAIRED_MAKER_MAX_QUEUES=25,50,100,250
PAIRED_MAKER_MAX_QUEUE_IMBALANCE=4

HYBRID_SHADOW_ENABLED=true
HYBRID_TRADE_SHARES=5
HYBRID_MIN_NET_EDGE_PER_SHARE=0.003
HYBRID_COMPLETION_LATENCY_MS=100
HYBRID_INVENTORY_TIMEOUT_MS=5000
HYBRID_MAX_HOLD_LOSS_PER_SHARE=0.02
HYBRID_MIN_REPRICE_INTERVAL_MS=500

# Shared SURGE / toxic-flow gate.
SURGE_MOVE_1S=0.04
SURGE_MOVE_3S=0.08
SURGE_UPDATES_PER_SECOND=300
SURGE_PAUSE_MS=1500
SURGE_ONE_SIDED_WINDOW_SECONDS=30
SURGE_ONE_SIDED_COUNT=3

# Phase 1.4 HEDGEABLE historical controls.
HEDGE_SHADOW_ENABLED=true
HEDGE_NET_EDGE_TARGETS=0.005,0.010,0.015,0.020
HEDGE_COMPLETION_LATENCIES_MS=50,100,200
HEDGE_SIZE_CANDIDATES=5,10,20,50
HEDGE_LATENCY_RESERVE_PER_SHARE=0.002
HEDGE_MIN_EXPECTED_PROFIT_USDC=0.10
HEDGE_MAX_IMPROVE_TICKS=1
HEDGE_MAX_QUOTE_AGE_MS=30000
HEDGE_REQUOTE_COOLDOWN_MS=500
HEDGE_MIN_SECONDS_TO_EXPIRY=30
HEDGE_EXTREME_PROBABILITY=0.10
HEDGE_TAKER_REBATE_SCENARIOS=0,0.03,0.08,0.18,0.30,0.50

HEDGE_GHOST_ENABLED=true
HEDGE_GHOST_HORIZON_MS=15000
HEDGE_GHOST_MAX_ACTIVE=500

# Phase 1.5.1 EV historical control.
EV_FRONTIER_ENABLED=true
EV_MIN_EXPECTED_PROFIT_USDC=0.01
EV_GRACE_EDGE_TARGET=0.005
EV_GRACE_LATENCY_MS=100
EV_GRACE_PERIODS_MS=0,100,250,500
EV_GRACE_TRADE_SHARES=5
EV_HARD_LOSS_PER_SHARE=0.005
EV_SIZE_EDGE_TARGET=0.005
EV_SIZE_LATENCY_MS=100
EV_SIZE_GRACE_MS=250
EV_SIZE_CANDIDATES=5,10,20,50

SPLIT_SELL_ENABLED=false
SPLIT_SELL_EDGE_TARGETS=0.005,0.010,0.015
SPLIT_SELL_SHARES=5
SPLIT_SELL_MAX_QUOTE_AGE_MS=30000
SPLIT_SELL_INVENTORY_TIMEOUT_MS=5000
SPLIT_SELL_REQUOTE_COOLDOWN_MS=500
SPLIT_SELL_MIN_SECONDS_TO_EXPIRY=30

# Phase 1.7 accelerated Dual-FOK execution frontier.
# No cross-order atomicity is assumed. Each individual FOK is all-or-nothing
# at the detection-time price limit. Net edge targets are AFTER taker fees.
DUAL_FOK_ENABLED=true
DUAL_FOK_BASE_LATENCY_MS=2
DUAL_FOK_RECOVERY_LATENCY_MS=10
DUAL_FOK_COOLDOWN_MS=100
DUAL_FOK_MAX_BOOK_AGE_MS=100
DUAL_FOK_USE_SURGE_GATE=true
DUAL_FOK_LEG_ORDER=fragile_first

DUAL_FOK_PRIMARY_SIZE=1
DUAL_FOK_PRIMARY_EDGE_TARGET=0.001
DUAL_FOK_PRIMARY_SKEW_MS=2
DUAL_FOK_PRIMARY_COVERAGE_MULTIPLE=2
DUAL_FOK_PRIMARY_STABILITY_MS=0

# Focused families: one variable changes at a time, not a Cartesian grid.
DUAL_FOK_SKEWS_MS=0,1,2,5,10,25
DUAL_FOK_SIZE_CANDIDATES=1,2,5,10
DUAL_FOK_EDGE_TARGETS=0.001,0.002,0.003,0.005,0.010
DUAL_FOK_COVERAGE_MULTIPLES=1,2,5
DUAL_FOK_STABILITY_PERIODS_MS=0,2,5,10,25,50

# Reverse complete-set taker experiment: sell pre-positioned UP+DOWN inventory.
REVERSE_DUAL_FOK_ENABLED=true
REVERSE_DUAL_FOK_SKEWS_MS=0,1,2,5,10,25

# Ideal atomic benchmark. This is NOT executable and never contributes to
# Session/All-Time shadow balance. It answers how much edge exists if both legs
# could be captured simultaneously at exactly one observed snapshot.
ATOMIC_BENCHMARK_ENABLED=true
ATOMIC_REVERSE_ENABLED=true
ATOMIC_SIZES=1,5,10,20
ATOMIC_MIN_NET_EDGE_PER_SHARE=0.0001
ATOMIC_EDGE_BANDS=0.001,0.002,0.003,0.005,0.010
ATOMIC_MAX_BOOK_AGE_MS=100

# Phase 1.7 ARB//TERM dashboard.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
DASHBOARD_REFRESH_MS=500
DASHBOARD_STATE_PATH=data/dashboard_state.json
DASHBOARD_EVENT_LIMIT=80
DASHBOARD_MAJOR_LOSS_USDC=0.25
DASHBOARD_MAJOR_WIN_USDC=0.10

# Empirical taker leg-risk measurement.
EMPIRICAL_RISK_MIN_SAMPLES=20
USE_EMPIRICAL_RISK_RESERVE=false

MARKET_REFRESH_SECONDS=60
DIAGNOSTIC_INTERVAL_SECONDS=10
EDGE_RECORD_MIN_INTERVAL_MS=0
OUTPUT_PATH=data/shadow_events.jsonl
LOG_LEVEL=INFO
RUN_SECONDS=0
