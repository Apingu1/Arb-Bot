# Phase 1.5 is observer/shadow only. No wallet, private key, signing or live order placement is used.
MARKET_QUERY=BTC Up or Down 15m

# Pure taker benchmark
MIN_NET_EDGE_PER_SHARE=0.005
MIN_EXPECTED_PROFIT_USDC=0.10
MIN_TRADE_SHARES=5
MAX_TRADE_SHARES=100
RISK_BUFFER_PER_SHARE=0.002
RECOVERY_PENALTY_PER_SHARE=0.002
SHADOW_LATENCY_MS=200
SHADOW_RECOVERY_LATENCY_MS=100
MARKET_COOLDOWN_MS=1000
MAX_BOOK_AGE_MS=1500

# Phase 1.3 queue-aware MAKER/HYBRID controls remain active for comparison.
MAKER_SHADOW_ENABLED=true
MAKER_TRADE_SHARES=5
MAKER_VARIANT_TARGETS=0.99,0.98,0.97,0.96
MAKER_TICK_SIZE=0.01
MAKER_MIN_GROSS_EDGE_PER_SHARE=0.005
MAKER_ORDER_TTL_MS=1500
MAKER_MAX_QUOTE_AGE_MS=30000
MAKER_REPRICE_TICKS=2
MAKER_REQUOTE_COOLDOWN_MS=500
MAKER_INVENTORY_TIMEOUT_MS=5000
MAKER_MIN_SECONDS_TO_EXPIRY=30
MAKER_USE_EMPIRICAL_RISK_GATE=false
MAKER_EMPIRICAL_RISK_MIN_SAMPLES=20

HYBRID_SHADOW_ENABLED=true
HYBRID_TRADE_SHARES=5
HYBRID_MIN_NET_EDGE_PER_SHARE=0.003
HYBRID_COMPLETION_LATENCY_MS=100
HYBRID_INVENTORY_TIMEOUT_MS=5000
HYBRID_MAX_HOLD_LOSS_PER_SHARE=0.02
HYBRID_MIN_REPRICE_INTERVAL_MS=500

# Shared SURGE / toxic-flow gate.
SURGE_MOVE_1S=0.04
SURGE_MOVE_3S=0.08
SURGE_UPDATES_PER_SECOND=300
SURGE_PAUSE_MS=1500
SURGE_ONE_SIDED_WINDOW_SECONDS=30
SURGE_ONE_SIDED_COUNT=3

# Phase 1.4 HEDGEABLE maker -> taker controls.
HEDGE_SHADOW_ENABLED=true
HEDGE_NET_EDGE_TARGETS=0.005,0.010,0.015,0.020
HEDGE_COMPLETION_LATENCIES_MS=50,100,200
HEDGE_SIZE_CANDIDATES=5,10,20,50
HEDGE_LATENCY_RESERVE_PER_SHARE=0.002
HEDGE_MIN_EXPECTED_PROFIT_USDC=0.10
HEDGE_MAX_IMPROVE_TICKS=1
HEDGE_MAX_QUOTE_AGE_MS=30000
HEDGE_REQUOTE_COOLDOWN_MS=500
HEDGE_MIN_SECONDS_TO_EXPIRY=30
HEDGE_EXTREME_PROBABILITY=0.10
HEDGE_TAKER_REBATE_SCENARIOS=0,0.03,0.08,0.18,0.30,0.50

# Phase 1.5 cancellation ghost tracking. Ghosts never affect equity/P&L; they
# answer whether a cancelled order would later have filled and been profitable.
HEDGE_GHOST_ENABLED=true
HEDGE_GHOST_HORIZON_MS=15000
HEDGE_GHOST_MAX_ACTIVE=500

# Phase 1.5 EV frontier: grace-period family.
EV_FRONTIER_ENABLED=true
EV_GRACE_EDGE_TARGET=0.005
EV_GRACE_LATENCY_MS=100
EV_GRACE_PERIODS_MS=0,100,250,500
EV_GRACE_TRADE_SHARES=5
# If current complete-set economics deteriorate below -0.5c/share during grace,
# cancel immediately rather than waiting for the grace timer.
EV_HARD_LOSS_PER_SHARE=0.005

# Phase 1.5 fixed-size family. Size is the only changing variable here.
EV_SIZE_EDGE_TARGET=0.005
EV_SIZE_LATENCY_MS=100
EV_SIZE_GRACE_MS=250
EV_SIZE_CANDIDATES=5,10,20,50

# Phase 1.5 mirror experiment: split pUSD into both outcomes and passively sell
# both tokens. Equal remaining inventory can be merged; only unmatched residual
# inventory is taker-unwound after a one-sided fill.
SPLIT_SELL_ENABLED=true
SPLIT_SELL_EDGE_TARGETS=0.005,0.010,0.015
SPLIT_SELL_SHARES=5
SPLIT_SELL_MAX_QUOTE_AGE_MS=30000
SPLIT_SELL_INVENTORY_TIMEOUT_MS=5000
SPLIT_SELL_REQUOTE_COOLDOWN_MS=500
SPLIT_SELL_MIN_SECONDS_TO_EXPIRY=30

# Empirical taker leg-risk measurement.
EMPIRICAL_RISK_MIN_SAMPLES=20
USE_EMPIRICAL_RISK_RESERVE=false

MARKET_REFRESH_SECONDS=60
DIAGNOSTIC_INTERVAL_SECONDS=10
# 0 records every relevant LIVE/NEXT book update; increase to throttle JSONL volume.
EDGE_RECORD_MIN_INTERVAL_MS=0
OUTPUT_PATH=data/shadow_events.jsonl
LOG_LEVEL=INFO
RUN_SECONDS=0
